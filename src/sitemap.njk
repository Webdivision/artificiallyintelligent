---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<url><loc>{{ site.url }}/</loc><lastmod>{{ collections.posts[0].date | isoDate }}</lastmod></url>
<url><loc>{{ site.url }}/archive/</loc></url>
{% for p in collections.posts %}<url><loc>{{ site.url }}{{ p.url }}</loc><lastmod>{{ p.date | isoDate }}</lastmod></url>
{% endfor %}</urlset>
