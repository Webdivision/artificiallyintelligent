<form class="subscribe-form" action="https://app.kit.com/forms/10047989/subscriptions" method="post" data-kit-form>
  <label class="visually-hidden" for="email-{{ formId or 'main' }}">Email address</label>
  <input id="email-{{ formId or 'main' }}" class="subscribe-input" type="email" name="email_address" placeholder="Your email address" autocomplete="email" required>
  <button class="subscribe-button" type="submit">Subscribe</button>
  <p class="subscribe-status" role="status" aria-live="polite"></p>
</form>
