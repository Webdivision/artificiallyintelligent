<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set pageTitle = (title + " | " + site.title) if title else (site.title + " | " + site.tagline) %}
{% set pageDesc = (content | excerpt(155)) if (tags and "posts" in tags) else site.description %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{{ 'article' if (tags and 'posts' in tags) else 'website' }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta name="twitter:card" content="summary">
<link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
<link rel="preload" href="/fonts/old-standard-tt-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/unifrakturmaguntia-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/style.css">
{% if tags and "posts" in tags %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"BlogPosting","headline":{{ title | json | safe }},"datePublished":"{{ page.date | isoDate }}","url":"{{ site.url }}{{ page.url }}","mainEntityOfPage":"{{ site.url }}{{ page.url }}","articleSection":"{{ section }}","author":{"@type":"Person","name":"Todd Blackmon","url":"https://webdivision.com"},"publisher":{"@type":"Organization","name":{{ site.title | json | safe }},"url":"{{ site.url }}/"}}</script>
{% elif page.url == "/" %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"Blog","name":{{ site.title | json | safe }},"url":"{{ site.url }}/","description":{{ site.description | json | safe }},"author":{"@type":"Person","name":"Todd Blackmon","url":"https://webdivision.com"}}</script>{% endif %}
</head>
<body class="{{ bodyClass }}">
<a class="skip" href="#main">Skip to content</a>
<div class="sheet">
{% if page.url == "/" %}{% include "masthead-full.njk" %}{% else %}{% include "masthead-compact.njk" %}{% endif %}
<main id="main">
{{ content | safe }}
</main>
<footer class="colophon">
  <div class="fleuron" aria-hidden="true">❧</div>
  <p class="colophon-title"><a href="/">{{ site.title }}</a></p>
  <p>Written &amp; published by {{ site.author }} in {{ site.place }}.</p>
  <nav aria-label="Footer"><a href="/">Front Page</a> · <a href="/archive/">Archive</a> · <a href="/feed.xml">Subscribe by RSS</a></nav>
  <p class="colophon-small">© {{ collections.posts[0].date | longDate | replace(r/^.*, /, "") }} {{ site.author }}. All rights reserved.</p>
</footer>
</div>
</body>
</html>
